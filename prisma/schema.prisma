// -----------------------------------------------------------------------------
// TRENDRUSH X - ENTERPRISE DATABASE SCHEMA
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USERS & CRM
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  document      String?   @unique // CPF/CNPJ
  role          UserRole  @default(CUSTOMER)
  ltv           Decimal   @default(0.00) @db.Decimal(10, 2)
  ordersCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?

  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  sessions      Session[]

  @@index([email])
  @@index([document])
}

enum UserRole {
  ADMIN
  MANAGER
  CUSTOMER
  VIP
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  country      String   @default("BR")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// CATALOG & INVENTORY (DROPSHIPPING OPTIMIZED)
// -----------------------------------------------------------------------------
model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id               String   @id @default(uuid())
  categoryId       String
  name             String
  slug             String   @unique
  shortDescription String
  description      String   @db.Text
  isViral          Boolean  @default(false)
  status           ProductStatus @default(DRAFT)
  
  // CJ Dropshipping / Supplier Data
  supplierUrl      String?
  supplierId       String?
  costPrice        Decimal  @db.Decimal(10, 2)
  
  // SEO
  seoTitle         String?
  seoDescription   String?
  
  // Analytics / Social Proof
  views            Int      @default(0)
  salesCount       Int      @default(0)
  rating           Decimal  @default(5.0) @db.Decimal(3, 2)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  reviews          Review[]
  crossSells       CrossSell[]      @relation("MainProduct")
  crossSellTargets CrossSell[]      @relation("TargetProduct")

  @@index([slug])
  @@index([isViral])
  @@index([status])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  sku             String   @unique
  name            String   // e.g., "Red / Large"
  price           Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  inventory       Int      @default(0)
  weight          Decimal? @db.Decimal(10, 3) // in KG
  imageUrl        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CrossSell {
  id              String   @id @default(uuid())
  productId       String
  targetProductId String
  type            CrossSellType @default(UPSELL)

  product         Product  @relation("MainProduct", fields: [productId], references: [id], onDelete: Cascade)
  targetProduct   Product  @relation("TargetProduct", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([productId, targetProductId])
}

enum CrossSellType {
  UPSELL
  CROSS_SELL
  BOUGHT_TOGETHER
}

// -----------------------------------------------------------------------------
// ORDERS, CHECKOUT & PAYMENTS
// -----------------------------------------------------------------------------
model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique // e.g., #TR-1001
  userId          String?     // Nullable for Guest Checkout
  guestEmail      String?
  status          OrderStatus @default(PENDING)
  
  // Financials
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingCost    Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  
  // Payment (Mercado Pago integration)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(AWAITING_PAYMENT)
  mercadoPagoId   String?       @unique
  pixQrCode       String?       @db.Text
  pixCopyPaste    String?       @db.Text
  installments    Int           @default(1)
  
  // Fulfillment & CJ Dropshipping
  trackingNumber  String?
  cjOrderId       String?
  
  // Coupon
  couponId        String?
  
  // Ads & Tracking
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  shippingAddress Json        // Snapshot of address at time of order

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

enum PaymentStatus {
  AWAITING_PAYMENT
  APPROVED
  IN_PROCESS
  REJECTED
  REFUNDED
  CHARGEBACK
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  variantId        String
  quantity         Int
  unitPrice        Decimal  @db.Decimal(10, 2)
  totalPrice       Decimal  @db.Decimal(10, 2)
  supplierCost     Decimal  @db.Decimal(10, 2) // Captured at time of sale for accurate ROI

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

// -----------------------------------------------------------------------------
// MARKETING & PROMOTIONS
// -----------------------------------------------------------------------------
model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  type           CouponType
  value          Decimal      @db.Decimal(10, 2) // % or Fixed Amount
  minPurchase    Decimal?     @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int          @default(0)
  validFrom      DateTime     @default(now())
  validUntil     DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  orders         Order[]

  @@index([code])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  author    String   // In case of imported reviews
  rating    Int      // 1-5
  comment   String   @db.Text
  imageUrl  String?
  isVerified Boolean @default(true)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId])
}

// -----------------------------------------------------------------------------
// SYSTEM LOGS & AUTOMATION
// -----------------------------------------------------------------------------
model WebhookLog {
  id         String   @id @default(uuid())
  source     String   // e.g., "MERCADO_PAGO", "CJ_DROPSHIPPING"
  eventId    String?
  payload    Json
  status     String   // "SUCCESS", "FAILED"
  error      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([source, status])
}